{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:utt:conversation-view:0.1-draft",
  "title": "Optional synthetic conversation display projection draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "source",
    "generated_status",
    "projects",
    "topics",
    "cross_conversation_candidates"
  ],
  "properties": {
    "format_version": {
      "const": "UTT-CONVERSATION-VIEW/0.1-draft"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_ref",
        "revision",
        "verification"
      ],
      "properties": {
        "conversation_ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "verified",
            "unverified",
            "synthetic"
          ]
        }
      }
    },
    "generated_status": {
      "enum": [
        "unreviewed_synthetic",
        "unreviewed",
        "reviewed"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "basis"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "explicit",
              "inferred",
              "unknown"
            ]
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_ref",
          "title",
          "message_refs",
          "claims"
        ],
        "properties": {
          "topic_ref": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "actor",
                "status",
                "evidence"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "actor": {
                  "enum": [
                    "user",
                    "assistant",
                    "both",
                    "unknown"
                  ]
                },
                "status": {
                  "enum": [
                    "viewpoint",
                    "proposal",
                    "confirmed",
                    "unresolved",
                    "deferred",
                    "disagreement",
                    "unknown"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "message_ref",
                      "source_revision",
                      "precision"
                    ],
                    "properties": {
                      "message_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_revision": {
                        "type": "string",
                        "minLength": 1
                      },
                      "precision": {
                        "enum": [
                          "message",
                          "span"
                        ]
                      },
                      "span": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "unit",
                          "start",
                          "end_exclusive"
                        ],
                        "properties": {
                          "unit": {
                            "const": "unicode_code_point"
                          },
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end_exclusive": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "precision": {
                              "const": "span"
                            }
                          },
                          "required": [
                            "precision"
                          ]
                        },
                        "then": {
                          "required": [
                            "span"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "span"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "cross_conversation_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_ref",
          "status",
          "merged",
          "reason"
        ],
        "properties": {
          "target_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "const": "candidate"
          },
          "merged": {
            "const": false
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
